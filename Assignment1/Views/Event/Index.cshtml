@model IEnumerable<Assignment1.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

<table class="table">
    <thead>
        <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@item.Location</td>
                <td>
                    <a class="btn btn-primary"
                    asp-controller="Event"
                    asp-action="ManageAttendees"
                    asp-route-id="@item.Id">
                    Manage Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>